OGF_NETWORK=
OGF_ANCHOR_PRIVATE_KEY=
#  OGF_ANCHOR_CONTRACT_ADDRESS u
OGF_ANCHOR_CONTRACT_ADDRESS=

# Groq (LLM Risk Agent)
GROQ_API_KEY=


# Aquarius DeFi Lab — environment template
# Copy to .env and fill. Never commit .env.

# API
AQUARIUS_API_URL=
PORT=


# ── Solana / Kamino (read path) ──────────────────────────────
# Production runs against TWO separate RPC Fast apps PLUS one fallback:
#   1) SERVER-SIDE PRIMARY (SOLANA_RPC_URL) — full-privilege key embedded
#      in URL. Used by the API for Kamino market loads, snapshot reads,
#      and simulate-shaped flows. NEVER prefix with NEXT_PUBLIC_.
#   2) SERVER-SIDE FALLBACK (SOLANA_RPC_URL_FALLBACK) — different provider
#      (e.g. Alchemy) used only when primary's circuit is open. Same
#      cluster as primary. Should target a free/low-cost tier (rare-by-
#      design traffic). NEVER reuse the primary URL here.
#   3) CLIENT-SIDE (NEXT_PUBLIC_SOLANA_RPC_URL below) — separate, lower
#      privilege RPC Fast app for browser wallet signing / broadcast.
# Cluster is pinned to mainnet-beta for production; ALL three URLs MUST
# point at the same cluster as KAMINO_MARKET_PUBKEY.
SOLANA_RPC_URL=
# Secondary RPC URL (Alchemy free tier recommended for outage independence).
# Format example: https://solana-mainnet.g.alchemy.com/v2/<api-key>
# For devnet: https://solana-devnet.g.alchemy.com/v2/<api-key>
# Leave blank to disable fallback (primary failures will not auto-route).
SOLANA_RPC_URL_FALLBACK=
SOLANA_CLUSTER=
# Per-RPC-call timeout (default: 12000). Tune from metrics, not vibes.
SOLANA_RPC_TIMEOUT_MS=12000
# Default Kamino lending market pubkey (base58). Required for live reads
# unless callers pass `market` explicitly on the route.
KAMINO_MARKET_PUBKEY=
# Force enable/disable live reads. Auto-on when SOLANA_RPC_URL is set
# and NODE_ENV != test. Set explicitly in prod for clarity.
# KAMINO_READ_ENABLED=true
# In-process KaminoMarket.load cache TTL (ms; 0 disables). Direct lever
# on RPC bill — keep > 0 in production.
KAMINO_MARKET_LOAD_CACHE_TTL_MS=
# Circuit breaker: open after N consecutive RPC failures, stay open M ms.
KAMINO_CIRCUIT_FAILURE_THRESHOLD=
KAMINO_CIRCUIT_OPEN_MS=
# Stale-snapshot fallback for CRE-integrated paths (last-good response
# when RPC is unavailable). Off in test, on otherwise.
# KAMINO_CRE_STALE_SNAPSHOT=true
# KAMINO_STALE_SNAPSHOT_MAX_AGE_MS=300000
# KAMINO_CRE_BACKGROUND_REFRESH=true

# ── Solana / Kamino (write path — simulate only) ─────────────
# Repay dry-run / simulateTransaction. Keep false until the wallet-signed
# flow is verified end-to-end on mainnet with conservative caps.
KAMINO_WRITE_ENABLED=
KAMINO_REPAY_SIMULATE_TIMEOUT_MS=
# Max human/UI repay amount per dry-run request (decimal string).
KAMINO_MAX_REPAY_UI=
# Optional comma-separated base58 mint allowlist (empty = any).
# KAMINO_ALLOWED_REPAY_MINTS=
# Per-route rate limit for the write-shaped route (requests/min).
# RATE_LIMIT_KAMINO_WRITE_MAX=24

# ── Web (browser) Solana RPC — separate RPC Fast app ─────────
# Browser-exposed at build time. The key ships in the JS bundle, so it
# is effectively semi-public. NEVER reuse SOLANA_RPC_URL here. Use a
# distinct RPC Fast app with stricter request caps and (if available)
# domain allowlisting on the provider side.
# NEXT_PUBLIC_SOLANA_RPC_URL=
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

NEXT_PUBLIC_SOLANA_CLUSTER=

NEXT_PUBLIC_KAMINO_USE_MOCK=




# Tenderly Virtual TestNet RPC (required for DATA_PROVIDER_MODE=tenderly)
TENDERLY_RPC_URL=
TENDERLY_FORK_ID=

# Mainnet / Live Chain RPC (required for DATA_PROVIDER_MODE=onchain)
RPC_URL=

# ── Real-Time Event Engine ───────────────────────────────────
# WebSocket URL for real-time event streaming
# Required for DATA_PROVIDER_MODE=realtime
# Supports: Alchemy WSS, Infura WSS, Tenderly WSS
WSS_URL=

# CCIP destination chains (comma-separated chain IDs)
CCIP_DESTINATION_CHAINS=

# ── Execution Mode ───────────────────────────────────────────
# CCC Execution: observe_only | simulated_ccc | local_don_ccc | real_ccc
EXECUTION_MODE=

# local_don_ccc safeguards (callback replay + timeout controls)
LOCAL_DON_CCC_CALLBACK_MAX_AGE_MS=
LOCAL_DON_CCC_REPLAY_TTL_MS=
LOCAL_DON_CCC_EXECUTION_TIMEOUT_MS=
LOCAL_DON_CCC_DEFAULT_USER=


# ── CRE Confidential HTTP (minimum real privacy flow) ────────
# Private CRE dispatch endpoint used by live action-layer adapter.
# Keep token server-side only (never use NEXT_PUBLIC_ prefix).
CRE_CONFIDENTIAL_HTTP_URL=
CRE_CONFIDENTIAL_HTTP_TOKEN=
# Workflow ID expected by internal webhook processor.
CRE_CONFIDENTIAL_WORKFLOW_ID=
# Optional callback URL for private endpoint to post back into Aquarius.
CRE_CONFIDENTIAL_CALLBACK_URL=
# Request timeout for confidential dispatch in milliseconds.
CRE_CONFIDENTIAL_HTTP_TIMEOUT_MS=


# Tenderly API (for fork management, optional)
TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_ACCOUNT=

# Add further keys as needed. Never hardcode secrets.


# ── Data Provider ────────────────────────────────────────────
# Market Data Provider: mock | tenderly | onchain | realtime
DATA_PROVIDER_MODE=
# Set to 1 in simulation validation to hard-require Tenderly mode
AAVE_VALIDATION_REQUIRE_TENDERLY=
#


# ── Phase B Policy Binding (Hard-fail) ────────────────────────
# Enable strict on-chain policy flow for activation/deactivation.
# In this mode, wallet signing is required and there is no fallback. 0 = DEMO, 1 = onCHAIN
PHASE_B_POLICY_BINDING=
NEXT_PUBLIC_PHASE_B_POLICY_BINDING=
# Per-chain policy binding contract addresses used by bind/deactivate intents.
POLICY_BINDING_CONTRACT_ETHEREUM=
POLICY_BINDING_CONTRACT_POLYGON=


# ── Arbitrum Sepolia (deploy + on-chain proof) ──
ARBITRUM_NETWORK=
ARBITRUM_RPC_URL=
ARBITRUM_DEPLOY_PRIVATE_KEY=
# After deploy:
# ARBITRUM_POLICY_GUARD_ADDRESS=0x...

# ── API demo (no mainnet Aave RPC) ──
DATA_PROVIDER_MODE=
PORT=
# Optional — stronger agent text in CRE output:
# GROQ_API_KEY=...