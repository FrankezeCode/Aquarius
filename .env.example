# Aquarius DeFi Lab — environment template
# Copy to .env and fill. Never commit .env.

# API
AQUARIUS_API_URL=http://localhost:3001
PORT=3001

# Web (apps/web) — NEXT_PUBLIC_* is embedded at build time.
# NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Kamino protocol page: in `next dev`, the Aave-style dashboard defaults to mock data.
# Set 0/false to show the live snapshot form only (until you fetch).
# Production builds only show mock when NEXT_PUBLIC_KAMINO_USE_MOCK=1|true.
# NEXT_PUBLIC_KAMINO_USE_MOCK=0

# Groq (LLM Risk Agent)
GROQ_API_KEY=

# ── Data Provider ────────────────────────────────────────────
# Market Data Provider: mock | tenderly | onchain | realtime
DATA_PROVIDER_MODE=mock
# Set to 1 in simulation validation to hard-require Tenderly mode
AAVE_VALIDATION_REQUIRE_TENDERLY=0
#
# Recommended simulation validation profile:
#   DATA_PROVIDER_MODE=tenderly
#   AAVE_VALIDATION_REQUIRE_TENDERLY=1
# In this profile, Aave validation endpoints return 503 when mode
# is not Tenderly, preventing accidental mock/onchain drift.

# Tenderly Virtual TestNet RPC (required for DATA_PROVIDER_MODE=tenderly)
TENDERLY_RPC_URL=
# Optional per-chain overrides for chain-aware Aave validation
TENDERLY_RPC_URL_ETHEREUM=
TENDERLY_RPC_URL_POLYGON=
TENDERLY_FORK_ID=

# Mainnet / Live Chain RPC (required for DATA_PROVIDER_MODE=onchain)
RPC_URL=
# Optional per-chain overrides for onchain mode
RPC_URL_ETHEREUM=
RPC_URL_POLYGON=

# ── Solana / Kamino (read path) ──────────────────────────────
# Production runs against TWO separate RPC Fast apps PLUS one fallback:
#   1) SERVER-SIDE PRIMARY (SOLANA_RPC_URL) — full-privilege key embedded
#      in URL. Used by the API for Kamino market loads, snapshot reads,
#      and simulate-shaped flows. NEVER prefix with NEXT_PUBLIC_.
#   2) SERVER-SIDE FALLBACK (SOLANA_RPC_URL_FALLBACK) — different provider
#      (e.g. Alchemy) used only when primary's circuit is open. Same
#      cluster as primary. Should target a free/low-cost tier (rare-by-
#      design traffic). NEVER reuse the primary URL here.
#   3) CLIENT-SIDE (NEXT_PUBLIC_SOLANA_RPC_URL below) — separate, lower
#      privilege RPC Fast app for browser wallet signing / broadcast.
# Cluster is pinned to mainnet-beta for production; ALL three URLs MUST
# point at the same cluster as KAMINO_MARKET_PUBKEY.
SOLANA_RPC_URL=
# Secondary RPC URL (Alchemy free tier recommended for outage independence).
# Format example: https://solana-mainnet.g.alchemy.com/v2/<api-key>
# For devnet: https://solana-devnet.g.alchemy.com/v2/<api-key>
# Leave blank to disable fallback (primary failures will not auto-route).
SOLANA_RPC_URL_FALLBACK=
SOLANA_CLUSTER=mainnet-beta
# Per-RPC-call timeout (default: 12000). Tune from metrics, not vibes.
SOLANA_RPC_TIMEOUT_MS=12000
# Default Kamino lending market pubkey (base58). Required for live reads
# unless callers pass `market` explicitly on the route.
KAMINO_MARKET_PUBKEY=
# Force enable/disable live reads. Auto-on when SOLANA_RPC_URL is set
# and NODE_ENV != test. Set explicitly in prod for clarity.
# KAMINO_READ_ENABLED=true
# In-process KaminoMarket.load cache TTL (ms; 0 disables). Direct lever
# on RPC bill — keep > 0 in production.
KAMINO_MARKET_LOAD_CACHE_TTL_MS=60000
# Circuit breaker: open after N consecutive RPC failures, stay open M ms.
KAMINO_CIRCUIT_FAILURE_THRESHOLD=5
KAMINO_CIRCUIT_OPEN_MS=30000
# Stale-snapshot fallback for CRE-integrated paths (last-good response
# when RPC is unavailable). Off in test, on otherwise.
# KAMINO_CRE_STALE_SNAPSHOT=true
# KAMINO_STALE_SNAPSHOT_MAX_AGE_MS=300000
# KAMINO_CRE_BACKGROUND_REFRESH=true

# ── Solana / Kamino (write path — simulate only) ─────────────
# Repay dry-run / simulateTransaction. Keep false until the wallet-signed
# flow is verified end-to-end on mainnet with conservative caps.
KAMINO_WRITE_ENABLED=false
KAMINO_REPAY_SIMULATE_TIMEOUT_MS=20000
# Max human/UI repay amount per dry-run request (decimal string).
KAMINO_MAX_REPAY_UI=1000000000
# Optional comma-separated base58 mint allowlist (empty = any).
# KAMINO_ALLOWED_REPAY_MINTS=
# Per-route rate limit for the write-shaped route (requests/min).
# RATE_LIMIT_KAMINO_WRITE_MAX=24

# ── Web (browser) Solana RPC — separate RPC Fast app ─────────
# Browser-exposed at build time. The key ships in the JS bundle, so it
# is effectively semi-public. NEVER reuse SOLANA_RPC_URL here. Use a
# distinct RPC Fast app with stricter request caps and (if available)
# domain allowlisting on the provider side.
#
# NEXT_PUBLIC_SOLANA_RPC_URL is reserved for future signed flows
# (browser-built txs read from this RPC, then submit via the connected
# wallet). The current Kamino monitor reads through the API — the
# wallet only supplies its own pubkey — so this URL is optional today.
# NEXT_PUBLIC_SOLANA_RPC_URL=
#
# NEXT_PUBLIC_SOLANA_CLUSTER pins the cluster the browser EXPECTS the
# API to be serving from. When set, the Kamino monitor renders an
# amber "Cluster mismatch" banner if the API's snapshot.metadata.
# solanaCluster differs (catches the foot-gun of a mainnet wallet
# pointed at a devnet API). Must equal SOLANA_CLUSTER.
# NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
#
# How often the connected-wallet view re-polls the snapshot endpoint
# (ms; default 30000, minimum 5000). Polling pauses while the tab is
# hidden and resumes immediately on visibility regain. Dial down only
# if you have a reason — every poll is one Kamino snapshot request.
# NEXT_PUBLIC_KAMINO_REFRESH_MS=30000

# ── Real-Time Event Engine ───────────────────────────────────
# WebSocket URL for real-time event streaming
# Required for DATA_PROVIDER_MODE=realtime
# Supports: Alchemy WSS, Infura WSS, Tenderly WSS
WSS_URL=

# CCIP destination chains (comma-separated chain IDs)
CCIP_DESTINATION_CHAINS=

# ── Execution Mode ───────────────────────────────────────────
# CCC Execution: observe_only | simulated_ccc | local_don_ccc | real_ccc
EXECUTION_MODE=observe_only

# local_don_ccc safeguards (callback replay + timeout controls)
LOCAL_DON_CCC_CALLBACK_MAX_AGE_MS=60000
LOCAL_DON_CCC_REPLAY_TTL_MS=600000
LOCAL_DON_CCC_EXECUTION_TIMEOUT_MS=20000
LOCAL_DON_CCC_DEFAULT_USER=

# ── CRE Confidential HTTP (minimum real privacy flow) ────────
# Private CRE dispatch endpoint used by live action-layer adapter.
# Keep token server-side only (never use NEXT_PUBLIC_ prefix).
CRE_CONFIDENTIAL_HTTP_URL=
CRE_CONFIDENTIAL_HTTP_TOKEN=
# Workflow ID expected by internal webhook processor.
CRE_CONFIDENTIAL_WORKFLOW_ID=aave-risk-confidential-http
# Optional callback URL for private endpoint to post back into Aquarius.
CRE_CONFIDENTIAL_CALLBACK_URL=
# Request timeout for confidential dispatch in milliseconds.
CRE_CONFIDENTIAL_HTTP_TIMEOUT_MS=5000

# ── Phase B Policy Binding (Hard-fail) ────────────────────────
# Enable strict on-chain policy flow for activation/deactivation.
# In this mode, wallet signing is required and there is no fallback.
PHASE_B_POLICY_BINDING=0
NEXT_PUBLIC_PHASE_B_POLICY_BINDING=0
# Per-chain policy binding contract addresses used by bind/deactivate intents.
POLICY_BINDING_CONTRACT_ETHEREUM=
POLICY_BINDING_CONTRACT_POLYGON=

# Tenderly API (for fork management, optional)
TENDERLY_ACCESS_KEY=
TENDERLY_PROJECT=
TENDERLY_ACCOUNT=

# Tenderly Virtual TestNet ID (for full-system validation explorer URLs)
TENDERLY_TESTNET_ID=

# ── Vault gateway execution (POST /api/v1/vault-gateway/intents) ──
# ADR 0003: defaults off in production until explicitly enabled.
VAULT_GATEWAY_EXECUTION_ENABLED=false
# Bearer secret(s) for POST. Use VAULT_GATEWAY_INTENT_TOKENS=a,b for rotation.
VAULT_GATEWAY_INTENT_TOKEN=
# ORCHESTRATION_EXECUTION_MODE=mock skips real CRE I/O (local/dev).
# ORCHESTRATION_EXECUTION_MODE=mock
# RATE_LIMIT_VAULT_GATEWAY_INTENTS_MAX=24
# VAULT_GATEWAY_IDEMPOTENCY_TTL_MS=86400000
# Phase 4 — Redis job store (optional; multi-instance staging)
# REDIS_URL=redis://localhost:6379
# ORCHESTRATION_JOB_TTL_SECONDS=604800
# VAULT_INTENT_CRE_WORKFLOW_ID=aave-risk-monitor
# CRE_VAULT_WORKFLOW_TRIGGER_URL=
# CRE_VAULT_WORKFLOW_TRIGGER_TOKEN=
# CRE_VAULT_WORKFLOW_TRIGGER_TIMEOUT_MS=10000
# VAULT_CRE_CALLBACK_URL=
# INTERNAL_VAULT_JOB_CALLBACK_SECRET=
# Simulated EOA for buffer top-up when using in-memory vault ports (Phase 5).
# VAULT_PROTOCOL_SIMULATED_OWNER=0x000000000000000000000000000000000000cafe
#
# Buffer solvency (internal metrics; see docs/runbooks/buffer-solvency.md)
# BUFFER_MINIMUM_TVL_USD=10000
# BUFFER_DRAWDOWN_WARNING_PCT=5
# BUFFER_REFILL_ASSUMED_USD_PER_HOUR=10000
# BUFFER_STRESS_DRAW_USD_PER_HOUR=5000
# BUFFER_STRESS_HORIZON_HOURS=24
# BUFFER_USD_PER_UNIT_JSON={"ETH":3000,"USDC":1}
#
# Phase 7 — PoS curated delegation (optional; testnet smoke)
# POS_DELEGATION_ENABLED_CHAINS=sepolia
# POS_DELEGATION_EXECUTION_MODE=mock
# POS_DELEGATION_EXECUTION_MODE=testnet
# POS_DELEGATION_RPC_URL=
# POS_DELEGATION_CHAIN_ID=11155111
# POS_DELEGATION_ROUTER_ADDRESS=
# POS_DELEGATION_OPERATOR_PRIVATE_KEY=
# Alias (same semantics as POS_DELEGATION_OPERATOR_PRIVATE_KEY):
# DELEGATION_OPERATOR_PRIVATE_KEY=

# Add further keys as needed. Never hardcode secrets.

# Enable strict on-chain policy flow for activation/deactivation.
# In this mode, wallet signing is required and there is no fallback.
PHASE_B_POLICY_BINDING=1
NEXT_PUBLIC_PHASE_B_POLICY_BINDING=1
# Per-chain policy binding contract addresses used by bind/deactivate intents.
POLICY_BINDING_CONTRACT_ETHEREUM=0xa97b35d0dacc291fff2c4f11ed2fca14686b71de
POLICY_BINDING_CONTRACT_POLYGON=