# Copy to .env.local — Next.js reads env from apps/web/ (not repo root).
#
# Kamino (/protocol/kamino): mock dashboard is ON by default in `pnpm dev`.
# Set to opt out and use only live GET /api/v1/kamino-risk/snapshot after fetch:
# NEXT_PUBLIC_KAMINO_USE_MOCK=0
#
# NEXT_PUBLIC_API_URL=http://localhost:3001
