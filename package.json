{
  "name": "aquarius-defi-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean --force && rm -rf node_modules",
    "run:agent": "tsx scripts/run-agent.ts",
    "run:cre": "tsx scripts/run-cre-simulation.ts",
    "run:ccc-demo": "tsx scripts/run-ccc-demo.ts",
    "run:confidential-validation": "tsx scripts/run-confidential-http-validation.ts",
    "run:local-cre-don-sim": "tsx scripts/run-confidential-http-validation.ts",
    "run:full-validation": "tsx scripts/run-full-validation.ts",
    "compile:contracts": "tsx scripts/compile-contracts.ts",
    "0g:chain:deploy": "pnpm --filter api exec tsx --env-file=../../.env scripts/0g-chain-anchor.ts deploy",
    "0g:chain:deploy:testnet": "pnpm --filter api run 0g:chain:deploy:testnet",
    "0g:chain:deploy:mainnet": "pnpm --filter api run 0g:chain:deploy:mainnet",
    "delegate:testnet-smoke": "tsx scripts/delegate-testnet-smoke.ts"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "solc": "^0.8.34",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0"
  }
}
